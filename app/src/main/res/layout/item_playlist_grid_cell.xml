<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_margin="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_tertiary">

        <ImageView
            android:id="@+id/iv_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- Иконка воспроизведения видео (если это видео) -->
    <ImageView
        android:id="@+id/iv_play_badge"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_play"
        android:layout_gravity="center"
        android:padding="6dp"
        android:background="@drawable/bg_play_overlay"
        app:tint="@android:color/white"
        android:visibility="gone" />

    <!-- Золотая рамка выделения активного элемента -->
    <View
        android:id="@+id/v_border_selected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gallery_selected_stroke"
        android:visibility="gone" />
</FrameLayout>
