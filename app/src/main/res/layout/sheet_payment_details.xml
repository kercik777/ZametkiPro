<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottomsheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Ручка шторки -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle"
        android:layout_marginBottom="20dp" />

    <!-- Название платежной системы -->
    <TextView
        android:id="@+id/tv_pay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gold_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Описание платежа -->
    <TextView
        android:id="@+id/tv_pay_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- Поле с реквизитами для копирования -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_settings_section"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РЕКВИЗИТЫ ДЛЯ ПЕРЕВОДА"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_pay_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_search_field"
            android:padding="14dp"
            android:textIsSelectable="true" />
    </LinearLayout>

    <!-- Кнопки действий -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Копировать -->
        <Button
            android:id="@+id/btn_copy_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Копировать реквизиты"
            android:textColor="@color/text_on_gold"
            android:background="@drawable/bg_button_gold"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Перейти к оплате (показывается если ссылка есть) -->
        <Button
            android:id="@+id/btn_go_to_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Перейти к оплате"
            android:textColor="@color/gold_primary"
            android:background="@drawable/bg_button_outline_gold"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Закрыть -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Закрыть"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_button_ghost"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
